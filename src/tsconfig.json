{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "strict": false,
        "noImplicitAny": false,
        "moduleResolution": "bundler",
        "paths": {
            "@assets/*": ["./assets/*"],
            "@core": ["./core/index"],
            "@core/*": ["./core/*"],
            "@effects/*": ["./effects/*"],
            "@examples/*": ["./examples/*"],
            "@sound/*": ["./sound/*"],
            "@platform": ["./platform/index"],
            "@platform/*": ["./platform/*"],
            "@engine/*": ["./engine/*"]
        },
        "esModuleInterop": true,
        "sourceMap": true,
        "types": [
            "node"
          ],
        "typeRoots": [ "../node_modules/@types" ]
    }
}
